{
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "moderate": {
        "$type": "duration",
        "$value": "200ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      },
      "contextual": {
        "$type": "duration",
        "$value": "{motion.duration.moderate}"
      },
      "expand": {
        "$type": "duration",
        "$value": "{motion.duration.moderate}"
      },
      "feedback": {
        "$type": "duration",
        "$value": "{motion.duration.fast}"
      },
      "overlay": {
        "$type": "duration",
        "$value": "{motion.duration.slow}"
      }
    }
  }
}
