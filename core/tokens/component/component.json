      "item": {
        "height": {
          "lg": {
            "$type": "dimension",
            "$value": "{component.control.size.lg}"
          },
          "md": {
            "$type": "dimension",
            "$value": "{component.control.size.md}"
          }
        },
        "indicator-thickness": {
          "$type": "dimension",
          "$value": "{stroke.2}"
        },
        "padding-inline": {
          "$type": "dimension",
          "$value": "{spacing.4}"
        }
      }
    },
    "textarea": {
      "min-height": {
        "lg": {
          "$type": "dimension",
          "$value": "{size.128}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{size.96}"
        }
      }
    },
    "toast": {
      "max-width": {
        "$type": "dimension",
        "$value": "320px"
      },
      "min-height": {
        "$type": "dimension",
        "$value": "{component.control.size.lg}"
      },
      "padding-block": {
        "$type": "dimension",
        "$value": "{spacing.3}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{spacing.4}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "stroke": {
        "$type": "dimension",
        "$value": "{stroke.1}"
      }
    },
    "tooltip": {
      "max-width": {
        "$type": "dimension",
        "$value": "240px"
      },
      "min-height": {
        "$type": "dimension",
        "$value": "{size.32}"
      },
      "padding-block": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      }
    }
  }
}
