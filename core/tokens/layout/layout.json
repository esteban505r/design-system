{
  "layout": {
    "breakpoint": {
      "wide": {
        "min": {
          "$type": "dimension",
          "$value": "1024px"
        }
      }
    },
    "container": {
      "content": {
        "max": {
          "$type": "dimension",
          "$value": "1280px"
        }
      }
    },
    "viewport": {
      "min-supported": {
        "$type": "dimension",
        "$value": "320px"
      },
      "reference": {
        "compact": {
          "$type": "dimension",
          "$value": "390px"
        },
        "wide": {
          "$type": "dimension",
          "$value": "1440px"
        }
      }
    },
    "compact": {
      "content": {
        "max-width": {
          "$type": "dimension",
          "$value": "{layout.container.content.max}"
        }
      },
      "grid": {
        "columns": {
          "$type": "number",
          "$value": 4
        },
        "gutter": {
          "$type": "dimension",
          "$value": "{spacing.4}"
        }
      },
      "page": {
        "padding-inline": {
          "$type": "dimension",
          "$value": "{spacing.4}"
        }
      }
    },
    "wide": {
      "content": {
        "max-width": {
          "$type": "dimension",
          "$value": "{layout.container.content.max}"
        }
      },
      "grid": {
        "columns": {
          "$type": "number",
          "$value": 12
        },
        "gutter": {
          "$type": "dimension",
          "$value": "{spacing.5}"
        }
      },
      "page": {
        "padding-inline": {
          "$type": "dimension",
          "$value": "{spacing.9}"
        }
      }
    }
  }
}
